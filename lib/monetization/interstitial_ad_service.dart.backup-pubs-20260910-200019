import 'dart:async';
import 'dart:io';

import 'package:flutter/foundation.dart';
import 'package:google_mobile_ads/google_mobile_ads.dart';
import 'package:shared_preferences/shared_preferences.dart';

import 'ad_free_entitlement.dart';
import 'ad_consent_service.dart';

class InterstitialAdService {
  InterstitialAdService._();

  static final InterstitialAdService instance = InterstitialAdService._();

  static const String _counterKey = 'geopoint_interstitial_game_counter';
  static const int gamesBetweenAds = 3;
  static const String _androidTestId =
      'ca-app-pub-3940256099942544/1033173712';
  static const String _iosTestId =
      'ca-app-pub-3940256099942544/4411468910';
  static const String _androidRewardedTestId =
      'ca-app-pub-3940256099942544/5224354917';
  static const String _iosRewardedTestId =
      'ca-app-pub-3940256099942544/1712485313';

  InterstitialAd? _ad;
  RewardedAd? _rewardedAd;
  bool _loading = false;
  bool _rewardedLoading = false;
  Completer<bool>? _rewardedLoadCompleter;
  bool _initialized = false;

  Future<void> initialize() async {
    if (_initialized || kIsWeb || (!Platform.isAndroid && !Platform.isIOS)) {
      return;
    }
    _initialized = true;
    if (!AdFreeAccess.instance.advertisementsAllowed) {
      return;
    }
    final bool consentAllowsAds =
        await AdConsentService.instance.gatherAtLaunch();
    if (!consentAllowsAds) {
      debugPrint(
        'PointGeo publicité : aucune demande envoyée sans consentement valide.',
      );
      return;
    }
    await MobileAds.instance.initialize();
    _load();
    unawaited(_ensureRewardedLoaded());
  }

  /// À appeler une seule fois après toute partie réellement terminée
  /// (entraînement, expédition ou défi).
  Future<bool> registerCompletedGame() async {
    if (!_initialized ||
        !AdFreeAccess.instance.advertisementsAllowed ||
        !AdConsentService.instance.canRequestAds) {
      return false;
    }
    final SharedPreferences preferences = await SharedPreferences.getInstance();
    final int next = (preferences.getInt(_counterKey) ?? 0) + 1;
    if (next < gamesBetweenAds) {
      await preferences.setInt(_counterKey, next);
      return false;
    }
    final InterstitialAd? readyAd = _ad;
    if (readyAd == null) {
      await preferences.setInt(_counterKey, gamesBetweenAds);
      _load();
      return false;
    }
    _ad = null;
    await preferences.setInt(_counterKey, 0);
    final Completer<void> closed = Completer<void>();
    readyAd.fullScreenContentCallback = FullScreenContentCallback<InterstitialAd>(
      onAdDismissedFullScreenContent: (InterstitialAd ad) {
        ad.dispose();
        if (!closed.isCompleted) closed.complete();
        _load();
      },
      onAdFailedToShowFullScreenContent: (InterstitialAd ad, AdError error) {
        ad.dispose();
        if (!closed.isCompleted) closed.complete();
        _load();
      },
    );
    readyAd.show();
    await closed.future;
    return true;
  }


  /// Affiche une publicité récompensée pour autoriser une nouvelle tentative
  /// de défi. La tentative n'est accordée que si la récompense a été reçue.
  /// Les joueurs disposant de l'avantage sans publicité n'appellent pas cette
  /// méthode : leur reprise reste gratuite.
  Future<bool> showRewardedChallengeRetry() async {
    if (!_initialized ||
        !AdFreeAccess.instance.advertisementsAllowed ||
        !AdConsentService.instance.canRequestAds) {
      return false;
    }

    if (!await _ensureRewardedLoaded()) {
      return false;
    }
    final RewardedAd? readyAd = _rewardedAd;
    if (readyAd == null) {
      return false;
    }

    _rewardedAd = null;
    bool rewardEarned = false;
    final Completer<bool> closed = Completer<bool>();
    readyAd.fullScreenContentCallback = FullScreenContentCallback<RewardedAd>(
      onAdDismissedFullScreenContent: (RewardedAd ad) {
        ad.dispose();
        if (!closed.isCompleted) closed.complete(rewardEarned);
        unawaited(_ensureRewardedLoaded());
      },
      onAdFailedToShowFullScreenContent: (RewardedAd ad, AdError error) {
        ad.dispose();
        if (!closed.isCompleted) closed.complete(false);
        unawaited(_ensureRewardedLoaded());
      },
    );
    readyAd.show(
      onUserEarnedReward: (AdWithoutView ad, RewardItem reward) {
        rewardEarned = true;
      },
    );
    return closed.future;
  }

  void _load() {
    if (_loading ||
        _ad != null ||
        !_initialized ||
        !AdConsentService.instance.canRequestAds) {
      return;
    }
    _loading = true;
    InterstitialAd.load(
      adUnitId: Platform.isAndroid ? _androidTestId : _iosTestId,
      request: const AdRequest(),
      adLoadCallback: InterstitialAdLoadCallback(
        onAdLoaded: (InterstitialAd ad) {
          _loading = false;
          _ad = ad;
        },
        onAdFailedToLoad: (LoadAdError error) {
          _loading = false;
          debugPrint('GeoPoint publicité : chargement différé ($error).');
        },
      ),
    );
  }

  Future<bool> _ensureRewardedLoaded() async {
    if (_rewardedAd != null) {
      return true;
    }
    if (!_initialized ||
        !AdFreeAccess.instance.advertisementsAllowed ||
        !AdConsentService.instance.canRequestAds) {
      return false;
    }
    if (_rewardedLoading) {
      return (_rewardedLoadCompleter ??= Completer<bool>()).future;
    }

    _rewardedLoading = true;
    final Completer<bool> completer = Completer<bool>();
    _rewardedLoadCompleter = completer;
    RewardedAd.load(
      adUnitId: Platform.isAndroid
          ? _androidRewardedTestId
          : _iosRewardedTestId,
      request: const AdRequest(),
      rewardedAdLoadCallback: RewardedAdLoadCallback(
        onAdLoaded: (RewardedAd ad) {
          _rewardedLoading = false;
          _rewardedAd = ad;
          if (!completer.isCompleted) completer.complete(true);
          if (identical(_rewardedLoadCompleter, completer)) {
            _rewardedLoadCompleter = null;
          }
        },
        onAdFailedToLoad: (LoadAdError error) {
          _rewardedLoading = false;
          debugPrint(
            'PointGeo publicité récompensée : chargement différé ($error).',
          );
          if (!completer.isCompleted) completer.complete(false);
          if (identical(_rewardedLoadCompleter, completer)) {
            _rewardedLoadCompleter = null;
          }
        },
      ),
    );
    return completer.future;
  }
}
